# Ne jamais committer le fichier .env (il contient les tokens).

# --- Mitti (ex-SafetyCulture) : token d'un COMPTE DE SERVICE ---
# Droits requis : voir et modifier toutes les actions de tous les sites, lire inspections et sites.
MITTI_API_TOKEN=
# MITTI_API_URL=https://api.mitti.com
# Lien vers une inspection, utilisé dans Smartsheet (à vérifier dans l'appli web)
# MITTI_INSPECTION_URL=https://app.safetyculture.com/inspection/{inspection_id}

# --- Smartsheet : token d'un COMPTE DE SERVICE ayant accès (éditeur) à toutes les feuilles Travaux ---
SMARTSHEET_API_TOKEN=

# --- Emails (relais SMTP Brevo) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# EMAIL_FROM_NAME=Safety-Sync

# --- Synchronisation (listes au format JSON) ---
# SAFETYSYNC_LOOKBACK_DAYS=30
# SAFETYSYNC_VALID_LABELS=["Premier Signalement", "En Panne", "En Service mais Maintenance", "Non OK", "Maintenance à effectuer"]
# Limiter aux trames Journalier/Hebdo (vide = toutes les actions « To do »)
# SAFETYSYNC_TEMPLATE_IDS=[]
# SAFETYSYNC_SECTION_TITLE=MAINTENANCE JEUX
# SAFETYSYNC_COMPLETION_HORIZON_DAYS=730

# --- Rapport du lundi ---
# Trames : mots-clés contenus dans le nom (casse ignorée, versions archivées comprises)
# et/ou IDs « template_… », séparés par des virgules. Vérifier avec `safety-sync diagnostic`.
SAFETYSYNC_JOURNALIER_TEMPLATES=Journalier
SAFETYSYNC_HEBDO_TEMPLATES=Hebdo
SAFETYSYNC_REPORT_TO=[]
# SAFETYSYNC_REPORT_CC=[]
# Régions = niveau « region » de l'arbre des sites Mitti
# SAFETYSYNC_REGION_LEVEL=region
# Sites à masquer dans le rapport (tests, parcs fermés…)
# SAFETYSYNC_EXCLUDED_SITES=[]
# SAFETYSYNC_OPENING_RATIO=0.2
# Contrôles suspects : durée mini absolue, ratio de la médiane réseau, heures plausibles
# SAFETYSYNC_MIN_DURATION_SECONDS=300
# SAFETYSYNC_MIN_HEBDO_DURATION_SECONDS=900
# SAFETYSYNC_SUSPICIOUS_DURATION_RATIO=0.4
# SAFETYSYNC_USUAL_HOUR_START=6
# SAFETYSYNC_USUAL_HOUR_END=23
# SAFETYSYNC_PERFECT_SCORE_CHECK=true
# SAFETYSYNC_PRIORITY_TOP=5

# --- Alertes techniques (erreurs d'exécution) ---
SAFETYSYNC_ALERT_TO=[]
# SAFETYSYNC_ALERT_CC=[]

# --- Logs (un fichier par jour) ---
# SAFETYSYNC_LOG_DIR=logs
# SAFETYSYNC_LOG_LEVEL=INFO
# SAFETYSYNC_LOG_MAX_FILES=30
